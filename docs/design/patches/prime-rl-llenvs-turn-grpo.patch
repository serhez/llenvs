+# --- llenvs_turn_grpo: per-decision credit from the llenvs-env relay ----------
+
+
+def _relay_episode(turn_rewards, spans, *, with_info=True, fork=False) -> vf.Episode:
+    """A linear relay trace: user/assistant alternation, the k-th assistant node
+    carrying ``spans[k]`` sampled tokens, with the llenvs turn-credit payload."""
+    nodes = []
+    parent = None
+    for k, span in enumerate(spans):
+        nodes.append(
+            MessageNode(
+                parent=parent,
+                message=UserMessage(content=f"U{k}"),
+                sampled=False,
+                token_ids=[100 + k],
+                mask=[False],
+            )
+        )
+        parent = len(nodes) - 1
+        nodes.append(
+            MessageNode(
+                parent=parent,
+                message=AssistantMessage(content=f"A{k}"),
+                sampled=True,
+                token_ids=list(range(span)),
+                mask=[True] * span,
+                logprobs=[-0.1] * span,
+            )
+        )
+        parent = len(nodes) - 1
+    if fork:
+        # A second sampled child of the first user node: two leaves, two branches.
+        nodes.append(
+            MessageNode(
+                parent=0,
+                message=AssistantMessage(content="A0-alt"),
+                sampled=True,
+                token_ids=[9],
+                mask=[True],
+                logprobs=[-0.1],
+            )
+        )
+    trace = vf.Trace(
+        task=vf.TraceTask(type="Task", data=vf.TaskData(idx=0, prompt=None)),
+        agent=vf.AgentInfo(config=vf.AgentConfig()),
+        nodes=nodes,
+        rewards={"llenvs/progress": Reward(score=float(sum(turn_rewards)))},
+        info={"llenvs": {"turn_rewards": list(turn_rewards)}} if with_info else {},
+        ok=True,
+    )
+    return vf.Episode(
+        env=vf.EnvInfo(id="llenvs-env", name="llenvs-env"),
+        task=trace.task,
+        group=vf.GroupInfo(id="group"),
+        traces=[trace],
+    )
+
+
+def _sampled_advantages(episode: vf.Episode) -> list[list[float]]:
+    return [node.advantages for node in episode.traces[0].nodes if any(node.mask)]
+
+
+def _score_turn_grpo(episodes: list[vf.Episode], **kwargs) -> None:
+    algo = LLEnvsTurnGRPOAlgorithm(_build(type="llenvs_turn_grpo", **kwargs), MagicMock())
+    asyncio.run(algo.score_group(episodes))
+
+
+def _score_grpo(episodes: list[vf.Episode]) -> None:
+    asyncio.run(GRPOAlgorithm(_build(type="grpo"), MagicMock()).score_group(episodes))
+
+
+def test_turn_grpo_config_defaults():
+    algo = _build(type="llenvs_turn_grpo")
+    assert algo.gamma == 1.0
+    assert algo.std_normalization is False
+    assert algo.length_weighting == "uniform"
+
+
+def test_turn_grpo_validate_env_requires_the_llenvs_relay():
+    with pytest.raises(ValueError, match="llenvs-env"):
+        _build(type="llenvs_turn_grpo").validate_env(vf.EnvConfig())
+
+
+def test_turn_grpo_validate_env_accepts_the_llenvs_relay():
+    pytest.importorskip("llenvs_env")
+    from llenvs_env.env import LLEnvsEnvConfig
+    from llenvs_env.taskset import LLEnvsTasksetConfig
+
+    _build(type="llenvs_turn_grpo").validate_env(
+        LLEnvsEnvConfig(taskset=LLEnvsTasksetConfig(id="llenvs-env"))
+    )
+
+
+def test_returns_to_go_discounts_per_decision():
+    assert returns_to_go([0.0, 1.0], 0.5) == [0.5, 1.0]
+    assert returns_to_go([1.0, 0.0, 2.0], 1.0) == [3.0, 2.0, 2.0]
+    assert returns_to_go([1.0, 1.0], 0.0) == [1.0, 1.0]
+
+
+def test_turn_grpo_return_to_go_pooled_over_the_group():
+    # Returns: [1, 0] and [0, 0] -> pooled mean 0.25.
+    won = _relay_episode([1.0, 0.0], spans=[2, 1])
+    lost = _relay_episode([0.0, 0.0], spans=[1, 1])
+    _score_turn_grpo([won, lost])
+    assert _sampled_advantages(won) == [[0.75, 0.75], [-0.25]]
+    assert _sampled_advantages(lost) == [[-0.25], [-0.25]]
+
+
+def test_turn_grpo_gamma_discounts_per_decision_not_per_token():
+    episode = _relay_episode([0.0, 1.0], spans=[3, 1])
+    _score_turn_grpo([episode], gamma=0.5)
+    # Returns [0.5, 1.0], pooled mean 0.75; the 3-token first turn shares one advantage.
+    assert _sampled_advantages(episode) == [[-0.25, -0.25, -0.25], [0.25]]
+
+
+def test_turn_grpo_broadcasts_over_each_turn_and_ships_a_full_stream():
+    episode = _relay_episode([1.0, 0.0], spans=[3, 2])
+    other = _relay_episode([0.0, 0.0], spans=[1, 1])
+    _score_turn_grpo([episode, other])
+    trace = episode.traces[0]
+    assert [len(a) for a in _sampled_advantages(episode)] == [3, 2]
+    sample = trace_to_samples(trace)[0]
+    # Returns [1, 0] and [0, 0]: pooled mean 0.25.
+    assert sample.advantages == [0.0, 0.75, 0.75, 0.75, 0.0, -0.25, -0.25]
+    assert len(sample.advantages) == sum(len(n.token_ids) for n in trace.nodes)
+
+
+def test_turn_grpo_pads_a_trailing_unstepped_turn_with_zero():
+    # Two sampled turns, one env step recorded: the trailing turn earns 0.
+    episode = _relay_episode([1.0], spans=[2, 1])
+    _score_turn_grpo([episode])
+    # Aligned rewards [1, 0] -> returns [1, 0] -> pooled mean 0.5.
+    assert _sampled_advantages(episode) == [[0.5, 0.5], [-0.5]]
+
+
+def test_turn_grpo_falls_back_to_grpo_scalar_when_nodes_and_turns_disagree():
+    def group():
+        return [
+            _relay_episode([1.0], spans=[1, 1, 1]),  # three sampled nodes, one reward
+            _relay_episode([0.0], spans=[1]),
+        ]
+
+    turn, grpo = group(), group()
+    _score_turn_grpo(turn)
+    _score_grpo(grpo)
+    # The misaligned trace gets reward - group mean = 1.0 - 0.5, exactly like GRPO.
+    assert _sampled_advantages(turn[0]) == _sampled_advantages(grpo[0]) == [[0.5], [0.5], [0.5]]
+    # The aligned trace is normalized over the pooled decision returns (just [0.0]).
+    assert _sampled_advantages(turn[1]) == [[0.0]]
+
+
+def test_turn_grpo_falls_back_to_grpo_for_forked_traces():
+    def group():
+        return [
+            _relay_episode([1.0], spans=[1], fork=True),
+            _relay_episode([0.0], spans=[1], with_info=False),
+        ]
+
+    turn, grpo = group(), group()
+    assert turn[0].traces[0].num_branches == 2
+    _score_turn_grpo(turn)
+    _score_grpo(grpo)
+    for scored, reference in zip(turn, grpo, strict=True):
+        assert _sampled_advantages(scored) == _sampled_advantages(reference)
+    assert _sampled_advantages(turn[0]) == [[0.5], [0.5]]
+
+
+def test_turn_grpo_without_turn_data_is_exactly_grpo():
+    def group():
+        return [
+            _relay_episode([1.0, 0.0], spans=[2, 1], with_info=False),
+            _relay_episode([0.0, 0.0], spans=[1, 2], with_info=False),
+        ]
+
+    turn, grpo = group(), group()
+    _score_turn_grpo(turn)
+    _score_grpo(grpo)
+    for scored, reference in zip(turn, grpo, strict=True):
+        assert _sampled_advantages(scored) == _sampled_advantages(reference)
+    assert _sampled_advantages(turn[0]) == [[0.5, 0.5], [0.5]]
+
+
+def test_turn_grpo_span_normalized_divides_by_the_turn_length():
+    long = _relay_episode([1.0], spans=[4])
+    short = _relay_episode([0.0], spans=[2])
+    _score_turn_grpo([long, short], length_weighting="span_normalized")
+    # Pooled mean 0.5: +0.5 spread over 4 tokens, -0.5 over 2.
+    assert _sampled_advantages(long) == [[0.125] * 4]
+    assert _sampled_advantages(short) == [[-0.25] * 2]
+
+
+def test_turn_grpo_std_normalization_with_zero_std_guard():
+    won, lost = _relay_episode([1.0], spans=[1]), _relay_episode([0.0], spans=[1])
+    _score_turn_grpo([won, lost], std_normalization=True)
+    # Pooled [1, 0]: mean 0.5, population std 0.5.
+    assert _sampled_advantages(won) == [[1.0]]
+    assert _sampled_advantages(lost) == [[-1.0]]
+
+    same = [_relay_episode([1.0], spans=[1]), _relay_episode([1.0], spans=[1])]
+    _score_turn_grpo(same, std_normalization=True)
+    assert [_sampled_advantages(e) for e in same] == [[[0.0]], [[0.0]]]
